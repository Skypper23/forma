# Variáveis de ambiente necessárias para o Vercel

# Origem pública da aplicação (OBRIGATÓRIO no Vercel)
# Exemplo: https://seu-projeto.vercel.app
PUBLIC_ORIGIN=https://seu-projeto.vercel.app

# Diretório de dados (opcional, usa ./data por padrão)
# FORMA_DATA_DIR=/tmp/forma-data

# Porta (automaticamente 3000 no Vercel)
# PORT=3000
